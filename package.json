{
  "name": "Version-Control-Homework",
  "version": "1.0.0",
  "description": "Eleventy generated web-site for G&D electro group.",
  "main": ".eleventy.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:css": "sass _assets/scss/styles.scss docs/css/styles.css --style=expanded --no-source-map",
    "build:html": "eleventy",
    "build": "npm run build:css && npm run build:html",
    "start": "concurrently \"sass --watch _assets/scss/styles.scss:docs/css/styles.css --style=expanded --no-source-map\" \"eleventy --serve\""
  },
  "repository": {
    "type": "git",
    "url": "git+git@github.com:plamenpik/Version-control-homework.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": ""
  },
  "homepage": "",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "concurrently": "^9.2.1",
    "npm-run-all": "^4.1.5",
    "sass": "^1.97.1"
  }
}
